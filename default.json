{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "LocalBytes org-wide Renovate defaults",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "timezone": "Europe/London",
  "cloneSubmodules": true,
  "minimumReleaseAge": "14 days",
  "semanticCommits": true,
  "packageRules": [
    {
      "matchPackageNames": [
        "localbytes",
        "@localbytes/**"
      ],
      "automerge": true
    }
  ],
  "git-submodules": {
    "enabled": true,
    "automerge": true
  }
}