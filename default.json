{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "LocalBytes org-wide Renovate defaults",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":automergeBranch",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "timezone": "Europe/London",
  "cloneSubmodules": true,
  "minimumReleaseAge": "14 days",
  "semanticCommits": true,
  "packageRules": [
    {
      "description": "1st party LocalBytes dependencies — automerge, no cooldown",
      "matchPackageNames": [
        "@localbytes/*",
        "https://github.com/localbytes/**"
      ],
      "automerge": true,
      "minimumReleaseAge": "0 days"
    }
  ],
  "nix": {
    "enabled": true
  },
  "git-submodules": {
    "enabled": true
  }
}
