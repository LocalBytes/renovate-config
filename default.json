{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "LocalBytes org-wide Renovate defaults",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "timezone": "Europe/London",
  "dependencyDashboard": false,
  "automergeType": "branch",
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "14 days",
  "pinDigests": true,
  "semanticCommits": true,
  "cloneSubmodules": true,
  "postUpdateOptions": ["pnpmDedupe", "composerNoMinimalChanges"],
  "packageRules": [
    {
      "description": "1st party LocalBytes dependencies — automerge, no cooldown",
      "matchPackageNames": [
        "@localbytes/*",
        "https://github.com/localbytes/**"
      ],
      "automerge": true,
      "minimumReleaseAge": "0 days"
    }
  ],
  "git-submodules": {
    "enabled": true,
    "automerge": true
  },
  "nix": {
    "enabled": true,
    "automerge": true
  },
  "pre-commit": {
    "enabled": true,
    "automerge": true
  }
}
