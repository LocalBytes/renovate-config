{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "LocalBytes org-wide Renovate defaults",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "timezone": "Europe/London",
  "dependencyDashboard": false,
  "automergeType": "branch",
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "14 days",
  "pinDigests": true,
  "semanticCommits": true,
  "cloneSubmodules": true,
  "postUpdateOptions": ["pnpmDedupe", "composerNoMinimalChanges"],
  "packageRules": [
    {
      "description": "1st party LocalBytes dependencies. Automerge with no cooldown.",
      "matchPackageNames": ["@localbytes/*"],
      "matchPackagePatterns": ["(?i)github\\.com/localbytes/"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Composer non-major updates",
      "matchManagers": ["composer"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchCurrentCount": ">1",
      "groupName": "Composer dependencies",
      "groupSlug": "composer"
    },
    {
      "description": "npm non-major updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchCurrentCount": ">1",
      "groupName": "npm dependencies",
      "groupSlug": "npm"
    },
    {
      "description": "Python non-major updates",
      "matchManagers": ["pip_requirements", "pip-compile", "pipenv", "uv"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchCurrentCount": ">1",
      "groupName": "Python dependencies",
      "groupSlug": "python"
    },
    {
      "description": "Docker non-major updates",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchCurrentCount": ">1",
      "groupName": "Docker dependencies",
      "groupSlug": "docker"
    },
    {
      "description": "GitHub Actions non-major updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchCurrentCount": ">1",
      "groupName": "GitHub Actions",
      "groupSlug": "gha"
    },
    {
      "description": "Nix non-major updates",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchCurrentCount": ">1",
      "groupName": "Nix dependencies",
      "groupSlug": "nix"
    },
    {
      "description": "pre-commit non-major updates",
      "matchManagers": ["pre-commit"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchCurrentCount": ">1",
      "groupName": "pre-commit hooks",
      "groupSlug": "pre-commit"
    }
  ],
  "git-submodules": {
    "enabled": true,
    "automerge": true
  },
  "nix": {
    "enabled": true,
    "automerge": true
  },
  "pre-commit": {
    "enabled": true,
    "automerge": true
  }
}
